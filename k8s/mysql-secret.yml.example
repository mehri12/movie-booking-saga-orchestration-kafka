# GABARIT : ne jamais mettre de vrai mot de passe dans ce fichier.
# Créer les vrais Secrets en ligne de commande :
#   kubectl create secret generic mysql-secret -n saga --from-literal=MYSQL_ROOT_PASSWORD='<mot-de-passe>'
#   kubectl create secret generic mysql-app-secret -n saga --from-literal=MYSQL_APP_PASSWORD='<mot-de-passe>'
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: saga
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: CHANGE_ME